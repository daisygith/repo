# Jednolite końce linii (LF) w repozytorium niezależnie od systemu.
# Ważne dla plików SQL i changelogów: czyste porównania zmian i stabilne sumy kontrolne Liquibase.
* text=auto eol=lf

# Skrypty Windows muszą mieć CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Pliki binarne
*.jar binary
*.zip binary
*.png binary
